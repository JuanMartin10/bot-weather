# Copy this file to .env and fill in the values. .env is never committed.

# Token given by @BotFather when the bot is created
TELEGRAM_BOT_TOKEN=

# Chat the bot writes to. Get it with `npm run chat-id`
TELEGRAM_CHAT_ID=

# Coordinates of the place to get the forecast for (example: Madrid city centre)
WEATHER_LATITUDE=40.4165
WEATHER_LONGITUDE=-3.70256
